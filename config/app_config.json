{
  "app_title": "Quant Interview Trainer",
  "page_icon": "📈",
  "layout": "wide",
  "app_intro_markdown": "A Streamlit-based active-recall platform for quantitative finance interview preparation.\n\nUse it to review questions, practise mock interviews, revise formulas, work through coding exercises, and maintain a structured public-safe interview question bank.",
  "default_status_filter": [
    "Verified",
    "Draft"
  ],
  "display_defaults": {
    "compact_mode": false,
    "show_tags": true,
    "show_intuition": true,
    "show_solution": true,
    "expand_solutions_by_default": false,
    "show_derivations": true,
    "show_code_examples": true,
    "show_complexity": true,
    "show_common_mistakes": true,
    "show_interview_tips": true,
    "questions_per_page": 25
  },
  "public_private_policy": {
    "public_question_file": "data/questions.json",
    "public_formula_file": "data/formulas.json",
    "private_folder": "private/",
    "private_folder_should_be_gitignored": true
  }
}